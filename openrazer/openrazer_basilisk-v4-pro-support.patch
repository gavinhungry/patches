+class RazerBasiliskV4ProWired(__RazerDevice):
+    """
+    Class for the Razer Basilisk V4 Pro (Wired)
+
+    Lighting-only proof of concept.
+    """
+    EVENT_FILE_REGEX = re.compile(r'.*Razer_Basilisk_V4_Pro_\w+-if0(1|2)-event-kbd')
