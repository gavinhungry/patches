-		update_chrome_flag (window, EV_CHROME_TOOLBAR, show_toolbar);
 	if (ev_metadata_get_boolean (priv->metadata, "sidebar_visibility", &show_sidebar))
 		update_chrome_flag (window, EV_CHROME_SIDEBAR, show_sidebar);
