diff --color -ru evince.ORIG/src/evince/shell/ev-window.c evince/src/evince/shell/ev-window.c
--- evince.ORIG/src/evince/shell/ev-window.c	2026-08-24 13:02:35.115456423 -0700
+++ evince/src/evince/shell/ev-window.c	2026-08-24 13:23:15.424958554 -0700
@@ -658,12 +658,13 @@
 {
 	EvWindowPrivate *priv = GET_PRIVATE (window);
 	gboolean toolbar, sidebar;
+	gboolean fullscreen;
 	gboolean presentation;
 
