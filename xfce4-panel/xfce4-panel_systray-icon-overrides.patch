+static void
+sn_config_load_icon_overrides (SnConfig *config)
+{
+  GKeyFile *key_file;
+  gchar *path;
+  gchar **keys;
+  gchar *key;
+  gchar *value;
+  const gchar *suffix;
+  GError *error = NULL;
+
+  g_hash_table_remove_all (config->icon_overrides);
+  g_hash_table_remove_all (config->icon_override_names);
+
+  path = g_file_get_path (config->icon_overrides_file);
+  key_file = g_key_file_new ();
+
+  if (g_key_file_load_from_file (key_file, path, G_KEY_FILE_NONE, &error))
+    {
+      keys = g_key_file_get_keys (key_file, ICON_OVERRIDES_GROUP, NULL, NULL);
+      for (gint n = 0; keys != NULL && keys[n] != NULL; n++)
+        {
+          value = g_key_file_get_string (key_file, ICON_OVERRIDES_GROUP, keys[n], NULL);
+          if (value != NULL && *value != '\0')
+            {
+              key = g_utf8_strdown (keys[n], -1);
+              g_hash_table_replace (config->icon_overrides, key, value);
+
+              /* item name without the ":fingerprint" or ":attention" suffix */
+              suffix = g_strrstr (key, ":");
+              g_hash_table_add (config->icon_override_names,
+                                suffix != NULL ? g_strndup (key, suffix - key) : g_strdup (key));
+            }
+          else
+            g_free (value);
+        }
+      g_strfreev (keys);
+    }
+  else
+    {
+      if (!g_error_matches (error, G_FILE_ERROR, G_FILE_ERROR_NOENT))
+        g_warning ("Failed to load %s: %s", path, error->message);
+      g_error_free (error);
+    }
+
+  g_key_file_free (key_file);
+  g_free (path);
+}
+
+
+
+static void
+sn_config_icon_overrides_changed (GFileMonitor *monitor,
+                                  GFile *file,
+                                  GFile *other_file,
+                                  GFileMonitorEvent event_type,
+                                  SnConfig *config)
+{
+  if (event_type != G_FILE_MONITOR_EVENT_CHANGES_DONE_HINT
+      && event_type != G_FILE_MONITOR_EVENT_CREATED
+      && event_type != G_FILE_MONITOR_EVENT_DELETED
+      && event_type != G_FILE_MONITOR_EVENT_RENAMED
+      && event_type != G_FILE_MONITOR_EVENT_MOVED_IN
+      && event_type != G_FILE_MONITOR_EVENT_MOVED_OUT)
+    return;
+
+  sn_config_load_icon_overrides (config);
+  g_signal_emit (G_OBJECT (config), sn_config_signals[ICONS_CHANGED], 0);
+}
+
+
+
+static void
+sn_config_init_icon_overrides (SnConfig *config)
+{
+  gchar *path;
+
+  path = g_build_filename (g_get_user_config_dir (), ICON_OVERRIDES_FILE, NULL);
+  config->icon_overrides_file = g_file_new_for_path (path);
+  g_free (path);
+
+  sn_config_load_icon_overrides (config);
+
+  config->icon_overrides_monitor = g_file_monitor_file (config->icon_overrides_file,
+                                                        G_FILE_MONITOR_WATCH_MOVES, NULL, NULL);
+  if (config->icon_overrides_monitor != NULL)
+    g_signal_connect (config->icon_overrides_monitor, "changed",
+                      G_CALLBACK (sn_config_icon_overrides_changed), config);
+}
