+static void
+systray_plugin_update_fingerprint (SystraySocket *socket,
+                                   SnPlugin *plugin,
+                                   gint width,
+                                   gint height)
+{
+  const gchar *name;
+  cairo_surface_t *surface;
+  cairo_t *cr;
+  GdkPixbuf *pixbuf;
+  gchar *fingerprint = NULL;
+  gint scale;
+
+  name = systray_socket_get_name (socket);
+  if (!sn_config_has_icon_override (plugin->config, name)
+      || width <= 0 || height <= 0)
+    return;
+
+  /* render the plug window as the app drew it */
+  scale = gtk_widget_get_scale_factor (GTK_WIDGET (socket));
+  surface = cairo_image_surface_create (CAIRO_FORMAT_ARGB32, width * scale, height * scale);
+  cr = cairo_create (surface);
+  cairo_scale (cr, scale, scale);
+  gdk_cairo_set_source_window (cr, gtk_widget_get_window (GTK_WIDGET (socket)), 0, 0);
+  cairo_paint (cr);
+  cairo_destroy (cr);
+
+  pixbuf = gdk_pixbuf_get_from_surface (surface, 0, 0, width * scale, height * scale);
+  cairo_surface_destroy (surface);
+  if (pixbuf != NULL)
+    fingerprint = sn_config_icon_fingerprint (pixbuf);
+
+  if (systray_socket_set_fingerprint (socket, fingerprint))
+    {
+      sn_config_capture_icon (plugin->config, name, fingerprint, pixbuf);
+      systray_plugin_update_override_icon (socket, plugin);
+    }
+
+  g_free (fingerprint);
+  if (pixbuf != NULL)
+    g_object_unref (pixbuf);
+}
