+gchar *
+sn_config_icon_fingerprint (GdkPixbuf *pixbuf)
+{
+  GChecksum *checksum;
+  const guchar *pixels;
+  gint width, height, rowstride, n_channels;
+  gboolean visible = FALSE;
+  gchar *fingerprint;
+
+  g_return_val_if_fail (GDK_IS_PIXBUF (pixbuf), NULL);
+
+  width = gdk_pixbuf_get_width (pixbuf);
+  height = gdk_pixbuf_get_height (pixbuf);
+  rowstride = gdk_pixbuf_get_rowstride (pixbuf);
+  n_channels = gdk_pixbuf_get_n_channels (pixbuf);
+  pixels = gdk_pixbuf_read_pixels (pixbuf);
+
+  /* a fully transparent image is most likely not drawn yet */
+  if (!gdk_pixbuf_get_has_alpha (pixbuf))
+    visible = TRUE;
+  for (gint y = 0; y < height && !visible; y++)
+    for (gint x = 0; x < width && !visible; x++)
+      if (pixels[y * rowstride + x * n_channels + 3] != 0)
+        visible = TRUE;
+
+  if (!visible)
+    return NULL;
+
+  checksum = g_checksum_new (G_CHECKSUM_SHA1);
+  g_checksum_update (checksum, (const guchar *) &width, sizeof (width));
+  g_checksum_update (checksum, (const guchar *) &height, sizeof (height));
+  for (gint y = 0; y < height; y++)
+    g_checksum_update (checksum, pixels + y * rowstride, width * n_channels);
+
+  fingerprint = g_strndup (g_checksum_get_string (checksum), ICON_FINGERPRINT_LENGTH);
+  g_checksum_free (checksum);
+
+  return fingerprint;
+}
+
