+static const gchar *
+sn_config_lookup_icon_override (SnConfig *config,
+                                const gchar *name,
+                                const gchar *suffix)
+{
+  const gchar *icon;
+  gchar *key;
+  gchar *key_lower;
+
+  key = suffix != NULL ? g_strconcat (name, ":", suffix, NULL) : g_strdup (name);
+  key_lower = g_utf8_strdown (key, -1);
+  icon = g_hash_table_lookup (config->icon_overrides, key_lower);
+  g_free (key_lower);
+  g_free (key);
+
+  return icon;
+}
+
+
+
+const gchar *
+sn_config_get_icon_override (SnConfig *config,
+                             const gchar *name,
+                             const gchar *fingerprint,
+                             gboolean attention)
+{
+  const gchar *icon = NULL;
+
+  g_return_val_if_fail (SN_IS_CONFIG (config), NULL);
+
+  if (name == NULL)
+    return NULL;
+
+  /* keys are stored lowercased, legacy item names are lowercased too */
+  if (fingerprint != NULL)
+    icon = sn_config_lookup_icon_override (config, name, fingerprint);
+  if (icon == NULL && attention)
+    icon = sn_config_lookup_icon_override (config, name, "attention");
+  if (icon == NULL)
+    icon = sn_config_lookup_icon_override (config, name, NULL);
+
+  return icon;
+}
+
+
+
+gboolean
+sn_config_has_icon_override (SnConfig *config,
+                             const gchar *name)
+{
+  gchar *key;
+  gboolean result;
+
+  g_return_val_if_fail (SN_IS_CONFIG (config), FALSE);
+
+  if (name == NULL)
+    return FALSE;
+
+  key = g_utf8_strdown (name, -1);
+  result = g_hash_table_contains (config->icon_override_names, key);
+  g_free (key);
+
+  return result;
+}
+
