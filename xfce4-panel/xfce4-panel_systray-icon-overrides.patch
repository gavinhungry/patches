+
+const gchar *
+systray_socket_get_override_icon (SystraySocket *socket)
+{
+  panel_return_val_if_fail (SYSTRAY_IS_SOCKET (socket), NULL);
+
+  return socket->override_icon;
+}
+
+
+
+void
+systray_socket_set_override_icon (SystraySocket *socket,
+                                  const gchar *icon)
+{
+  panel_return_if_fail (SYSTRAY_IS_SOCKET (socket));
+
+  if (g_strcmp0 (socket->override_icon, icon) == 0)
+    return;
+
+  g_free (socket->override_icon);
+  socket->override_icon = g_strdup (icon);
+  systray_socket_clear_override_surface (socket);
+}
+
+
+
+const gchar *
+systray_socket_get_fingerprint (SystraySocket *socket)
+{
+  panel_return_val_if_fail (SYSTRAY_IS_SOCKET (socket), NULL);
+
+  return socket->fingerprint;
+}
+
+
+
+gboolean
+systray_socket_set_fingerprint (SystraySocket *socket,
+                                const gchar *fingerprint)
+{
+  panel_return_val_if_fail (SYSTRAY_IS_SOCKET (socket), FALSE);
+
+  if (g_strcmp0 (socket->fingerprint, fingerprint) == 0)
+    return FALSE;
+
+  g_free (socket->fingerprint);
+  socket->fingerprint = g_strdup (fingerprint);
+
+  return TRUE;
+}
+
+
+
+void
+systray_socket_clear_override_surface (SystraySocket *socket)
+{
+  panel_return_if_fail (SYSTRAY_IS_SOCKET (socket));
+
+  if (socket->override_surface != NULL)
+    {
+      cairo_surface_destroy (socket->override_surface);
+      socket->override_surface = NULL;
+    }
+  socket->override_surface_size = 0;
+  socket->override_surface_scale = 0;
+}
+
+
+
+cairo_surface_t *
+systray_socket_get_override_surface (SystraySocket *socket,
+                                     gint size,
+                                     gint scale)
+{
+  GtkIconTheme *icon_theme;
+  GdkPixbuf *pixbuf;
+  GError *error = NULL;
+
+  panel_return_val_if_fail (SYSTRAY_IS_SOCKET (socket), NULL);
+
+  if (socket->override_icon == NULL || size <= 0)
+    return NULL;
+
+  if (socket->override_surface_size == size && socket->override_surface_scale == scale)
+    return socket->override_surface;
+
+  systray_socket_clear_override_surface (socket);
+  socket->override_surface_size = size;
+  socket->override_surface_scale = scale;
+
+  if (g_path_is_absolute (socket->override_icon))
+    {
+      pixbuf = gdk_pixbuf_new_from_file_at_size (socket->override_icon,
+                                                 size * scale, size * scale, &error);
+      if (pixbuf != NULL)
+        {
+          socket->override_surface = gdk_cairo_surface_create_from_pixbuf (pixbuf, scale, NULL);
+          g_object_unref (pixbuf);
+        }
+    }
+  else
+    {
+      icon_theme = gtk_icon_theme_get_for_screen (gtk_widget_get_screen (GTK_WIDGET (socket)));
+      socket->override_surface = gtk_icon_theme_load_surface (icon_theme, socket->override_icon,
+                                                              size, scale, NULL,
+                                                              GTK_ICON_LOOKUP_FORCE_SIZE, &error);
+    }
+
+  if (error != NULL)
+    g_error_free (error);
+
+  return socket->override_surface;
+}
