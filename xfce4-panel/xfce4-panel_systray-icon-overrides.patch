+typedef struct
+{
+  gchar *path;
+  gint64 mtime;
+} SnCapture;
+
+
+
+static void
+sn_config_capture_free (gpointer data)
+{
+  SnCapture *capture = data;
+
+  g_free (capture->path);
+  g_free (capture);
+}
+
+
+
+static gint
+sn_config_capture_compare (gconstpointer a,
+                           gconstpointer b)
+{
+  const SnCapture *capture_a = a;
+  const SnCapture *capture_b = b;
+
+  return (capture_a->mtime > capture_b->mtime) - (capture_a->mtime < capture_b->mtime);
+}
+
+
+
+static gboolean
+sn_config_is_capture_of (const gchar *filename,
+                         const gchar *prefix)
+{
+  gsize prefix_len = strlen (prefix);
+
+  /* "<prefix><fingerprint>.png", so "discord-ptb-..." is not a capture of "discord" */
+  if (strlen (filename) != prefix_len + ICON_FINGERPRINT_LENGTH + strlen (".png")
+      || !g_str_has_prefix (filename, prefix)
+      || !g_str_has_suffix (filename, ".png"))
+    return FALSE;
+
+  for (gsize n = prefix_len; n < prefix_len + ICON_FINGERPRINT_LENGTH; n++)
+    if (!g_ascii_isxdigit (filename[n]))
+      return FALSE;
+
+  return TRUE;
+}
+
+
+
+void
+sn_config_capture_icon (SnConfig *config,
+                        const gchar *name,
+                        const gchar *fingerprint,
+                        GdkPixbuf *pixbuf)
+{
+  gchar *dir_path;
+  gchar *safe_name;
+  gchar *prefix;
+  gchar *filename;
+  gchar *path;
+  const gchar *entry;
+  GDir *dir;
+  GList *captures = NULL;
+  GList *li;
+  guint count;
+  SnCapture *capture;
+  GStatBuf st;
+  GError *error = NULL;
+
+  g_return_if_fail (SN_IS_CONFIG (config));
+
+  if (name == NULL || fingerprint == NULL || pixbuf == NULL
+      || !sn_config_has_icon_override (config, name))
+    return;
+
+  dir_path = g_build_filename (g_get_user_cache_dir (), ICON_CAPTURE_DIR, NULL);
+  safe_name = g_utf8_strdown (name, -1);
+  g_strcanon (safe_name, G_CSET_a_2_z G_CSET_DIGITS "-_.", '_');
+  prefix = g_strconcat (safe_name, "-", NULL);
+  filename = g_strconcat (prefix, fingerprint, ".png", NULL);
+  path = g_build_filename (dir_path, filename, NULL);
+
+  if (g_file_test (path, G_FILE_TEST_EXISTS))
+    goto out;
+
+  if (g_mkdir_with_parents (dir_path, 0700) != 0)
+    {
+      g_warning ("Failed to create %s: %s", dir_path, g_strerror (errno));
+      goto out;
+    }
+
+  /* keep only the most recent captures per item, e.g. for animated icons */
+  dir = g_dir_open (dir_path, 0, NULL);
+  if (dir != NULL)
+    {
+      while ((entry = g_dir_read_name (dir)) != NULL)
+        {
+          if (!sn_config_is_capture_of (entry, prefix))
+            continue;
+
+          capture = g_new0 (SnCapture, 1);
+          capture->path = g_build_filename (dir_path, entry, NULL);
+          if (g_stat (capture->path, &st) == 0)
+            capture->mtime = st.st_mtime;
+          captures = g_list_prepend (captures, capture);
+        }
+      g_dir_close (dir);
+    }
+
+  captures = g_list_sort (captures, sn_config_capture_compare);
+  count = g_list_length (captures);
+  for (li = captures; li != NULL && count >= ICON_CAPTURE_MAX; li = li->next, count--)
+    g_remove (((SnCapture *) li->data)->path);
+  g_list_free_full (captures, sn_config_capture_free);
+
+  if (!gdk_pixbuf_save (pixbuf, path, "png", &error, NULL))
+    {
+      g_warning ("Failed to save %s: %s", path, error->message);
+      g_error_free (error);
+    }
+
+out:
+  g_free (path);
+  g_free (filename);
+  g_free (prefix);
+  g_free (safe_name);
+  g_free (dir_path);
+}
