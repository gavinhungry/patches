@@ -72,6 +79,28 @@
 
 
 
+static gint
+tasklist_plugin_get_env_width (void)
+{
+  const gchar *value;
+  gchar *end;
+  gint64 width;
+
+  value = g_getenv ("XFCE_PANEL_TASKLIST_WIDTH");
+  if (value == NULL || *value == '\0')
+    return -1;
+
+  errno = 0;
+  width = g_ascii_strtoll (value, &end, 10);
+  if (errno == ERANGE || end == value || *end != '\0'
+      || width < 1 || width > G_MAXINT)
+    return -1;
+
+  return (gint) width;
+}
+
+
+
 static void
 tasklist_plugin_class_init (TasklistPluginClass *klass)
 {
@@ -114,6 +143,9 @@
   g_object_bind_property (G_OBJECT (plugin->tasklist), "show-handle",
                           G_OBJECT (plugin->handle), "visible",
                           G_BINDING_SYNC_CREATE);
+
+  g_signal_connect_after (plugin, "size-allocate",
+                          G_CALLBACK (tasklist_plugin_size_allocate), plugin);
 }
 
 
@@ -122,6 +154,7 @@
 tasklist_plugin_construct (XfcePanelPlugin *panel_plugin)
 {
   TasklistPlugin *plugin = TASKLIST_PLUGIN (panel_plugin);
+  gint width;
   const PanelProperty properties[] = {
     { "show-labels", G_TYPE_BOOLEAN },
     { "grouping", G_TYPE_BOOLEAN },
@@ -153,11 +186,49 @@
                          xfce_panel_plugin_get_property_base (panel_plugin),
                          properties, FALSE);
 
+  width = tasklist_plugin_get_env_width ();
+  if (width > 0)
+    {
+      gtk_widget_set_size_request (GTK_WIDGET (plugin), width, -1);
+      plugin->center_tasklist = TRUE;
+    }
+
   /* show the tasklist */
   gtk_widget_show (plugin->tasklist);
 }
 
 
+
+static void
+tasklist_plugin_size_allocate (GtkWidget *widget,
+                               GtkAllocation *allocation,
+                               TasklistPlugin *plugin)
+{
+  GtkWidget *itembar;
+  GtkAllocation itembar_allocation;
+  gint desired_x;
+  gint margin;
+
+  if (!plugin->center_tasklist
+      || xfce_panel_plugin_get_orientation (XFCE_PANEL_PLUGIN (plugin)) != GTK_ORIENTATION_HORIZONTAL)
+    return;
+
+  itembar = gtk_widget_get_parent (widget);
+  if (itembar == NULL)
+    return;
+
+  gtk_widget_get_allocation (itembar, &itembar_allocation);
+  if (itembar_allocation.width <= 0)
+    return;
+
+  desired_x = itembar_allocation.x + (itembar_allocation.width - allocation->width) / 2;
+  margin = MAX (0, gtk_widget_get_margin_start (widget) + desired_x - allocation->x);
+
+  if (margin != gtk_widget_get_margin_start (widget))
+    gtk_widget_set_margin_start (widget, margin);
+}
