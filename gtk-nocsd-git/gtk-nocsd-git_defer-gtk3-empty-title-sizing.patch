+static gboolean GTKNoCSDGTK3EmptyTitleSize(gpointer Data) {
+	// Make the headerbar take as much space as it would naturally after GTK has
+	// finished the current size request.
+
+	GtkWidget *Header = (GtkWidget *) Data;
+	if (o_g_object_get_data((GObject *) Header,
+		"GTKNoCSDEmptyTitlePending") == Header) {
+		o_g_object_set_data((GObject *) Header, "GTKNoCSDEmptyTitlePending",
+			NULL);
+		int Width = -1;
+		o_gtk_widget_get_preferred_width(Header, NULL, &Width);
+		o_gtk_widget_set_size_request(Header, Width, -1);
+	}
+	o_g_object_unref((GObject *) Header);
+
+	return FALSE;
+}
