@@ -96,6 +96,28 @@
     return false;
 }
 
+/*
+ * Evaluate a match option from the winrules plugin against a window.
+ * Core cannot use winrules' generated option accessors, so the option is
+ * looked up by name. Returns false if winrules is not loaded, or the
+ * option is missing or not a match.
+ */
+static bool
+windowMatchesWinrulesOption (const CompWindow *w,
+			     const char       *name)
+{
+    CompPlugin *winrules = CompPlugin::find ("winrules");
+
+    if (!winrules)
+	return false;
+
+    CompOption *option =
+	CompOption::findOption (winrules->vTable->getOptions (), name);
+
+    return option && option->type () == CompOption::TypeMatch &&
+	   option->value ().match ().evaluate (w);
+}
+
 #define REAL_MOD_MASK (ShiftMask | ControlMask | Mod1Mask | Mod2Mask | \
 		       Mod3Mask | Mod4Mask | Mod5Mask | CompNoMask)
 
