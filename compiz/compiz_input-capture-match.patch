+/*
+ * Let modifier+button move/resize bindings fall through to input-capturing
+ * clients (remote desktop viewers, VMs, etc. -- see the winrules
+ * input_capture_match option) so the guest/remote session can use the
+ * same bindings. We only do this when the window is focused (i.e. it has
+ * grabbed the keyboard) and the pointer is inside its client area, so the
+ * window itself can still be moved/resized by modifier+dragging its
+ * decorations.
+ *
+ * The option lives in the winrules plugin (which also pulls in regex, for
+ * class=/name=/title= matching), so it is looked up by name here. If
+ * winrules is not loaded, or the option is empty (the default), nothing
+ * is passed through.
+ *
+ * Plugins return false from their initiate callback when this is true,
+ * which causes core to replay the button press to the client (see
+ * XAllowEvents/ReplayPointer in CompScreenImpl::_handleEvent).
+ */
+bool
+CompWindow::clientCapturesButtonAction (CompAction::State  state,
+					CompOption::Vector &options) const
+{
+    if (!(state & CompAction::StateInitButton))
+	return false;
+
+    if (CompOption::getBoolOptionNamed (options, "external", false))
+	return false;
+
+    CompPlugin *winrules = CompPlugin::find ("winrules");
+
+    if (!winrules)
+	return false;
+
+    CompOption *match =
+	CompOption::findOption (winrules->vTable->getOptions (),
+				"input_capture_match");
+
+    if (!match || match->type () != CompOption::TypeMatch ||
+	!match->value ().match ().evaluate (this))
+	return false;
+
+    if (priv->id != screen->activeWindow ())
+	return false;
+
+    int x = CompOption::getIntOptionNamed (options, "x", pointerX);
+    int y = CompOption::getIntOptionNamed (options, "y", pointerY);
+
+    return priv->geometry.contains (CompPoint (x, y));
+}
